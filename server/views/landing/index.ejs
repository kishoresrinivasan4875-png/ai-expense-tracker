<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head-app') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <header class="hero">
    <div class="container">
      <div class="row align-items-center gy-5">
        <div class="col-lg-6 hero-copy">
          <span class="badge app-badge mb-3">Cognifyz Full Stack Internship Project</span>
          <h1 class="hero-title">Know exactly where your money goes.</h1>
          <p class="hero-subtitle">
            AI Expense Tracker helps you log spending in seconds, keep it organized
            by category, and understand your habits with a clean, focused dashboard.
          </p>
          <div class="d-flex flex-wrap gap-3">
            <a href="/task3/signup" class="btn btn-primary btn-lg app-btn-cta">Get Started Free</a>
            <a href="/task3/login" class="btn btn-outline-light btn-lg">Log In</a>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="hero-card">
            <div class="hero-card-row">
              <span>This Month</span>
              <strong>&#8377;11,500</strong>
            </div>
            <div class="hero-card-bar">
              <div class="hero-card-bar-fill" style="width: 68%;"></div>
            </div>
            <ul class="hero-card-list">
              <li><span class="dot dot-food"></span>Food<span class="ms-auto">&#8377;5,000</span></li>
              <li><span class="dot dot-transport"></span>Transport<span class="ms-auto">&#8377;2,500</span></li>
              <li><span class="dot dot-bills"></span>Bills<span class="ms-auto">&#8377;4,000</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="features py-5">
    <div class="container">
      <div class="text-center mb-5">
        <h2 class="section-title">Everything you need, nothing you don't</h2>
        <p class="section-subtitle">A focused toolset for tracking day-to-day spending.</p>
      </div>
      <div class="row g-4">
        <div class="col-md-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-lightning-charge"></i></div>
            <h3>Fast Entry</h3>
            <p>Add an expense in seconds with a clean, validated form.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-tags"></i></div>
            <h3>Smart Categories</h3>
            <p>Every expense is organized into clear spending categories.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-graph-up"></i></div>
            <h3>Live Dashboard</h3>
            <p>See totals, monthly spend, and category breakdowns at a glance.</p>
          </div>
        </div>
        <div class="col-md-6 col-lg-3">
          <div class="feature-card">
            <div class="feature-icon"><i class="bi bi-shield-lock"></i></div>
            <h3>Private by Design</h3>
            <p>Every expense is tied to one account and never shared.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="container text-center py-5">
      <h2 class="mb-3">Ready to see where your money goes?</h2>
      <a href="/task3/signup" class="btn btn-primary btn-lg app-btn-cta">Create your free account</a>
    </div>
  </section>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
