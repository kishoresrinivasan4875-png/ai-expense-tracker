<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head-app') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="auth-page">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
          <div class="auth-card">
            <h1 class="auth-title">Create your account</h1>
            <p class="auth-subtitle">Start tracking your spending in minutes.</p>

            <form id="signupForm" action="/task3/signup" method="POST" novalidate>
              <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input type="text" class="form-control <%= errors.username ? 'is-invalid' : '' %>" id="username" name="username" value="<%= formData.username %>">
                <div class="invalid-feedback" id="usernameError"><%= errors.username || '' %></div>
              </div>
              <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="text" class="form-control <%= errors.email ? 'is-invalid' : '' %>" id="email" name="email" value="<%= formData.email %>">
                <div class="invalid-feedback" id="emailError"><%= errors.email || '' %></div>
              </div>
              <div class="mb-3">
                <label for="password" class="form-label">Password</label>
                <input type="password" class="form-control <%= errors.password ? 'is-invalid' : '' %>" id="password" name="password">
                <div class="invalid-feedback" id="passwordError"><%= errors.password || '' %></div>
                <div class="form-text">At least 8 characters, with a letter and a number.</div>
              </div>
              <div class="mb-3">
                <label for="confirmPassword" class="form-label">Confirm Password</label>
                <input type="password" class="form-control <%= errors.confirmPassword ? 'is-invalid' : '' %>" id="confirmPassword" name="confirmPassword">
                <div class="invalid-feedback" id="confirmPasswordError"><%= errors.confirmPassword || '' %></div>
              </div>
              <button type="submit" class="btn btn-primary w-100 app-btn-cta">Sign Up</button>
            </form>

            <p class="auth-footnote">
              Already have an account? <a href="/task3/login">Log in</a>
            </p>
            <p class="auth-footnote auth-footnote-muted">
              Note: passwords are validated but not yet hashed or permanently stored —
              real accounts with password hashing arrive in Task 6.
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>

  <script>
    // Inline client-side validation (same rules as Task 2's signup demo).
    document.getElementById('signupForm').addEventListener('submit', function (event) {
      var valid = true;

      function setError(fieldId, message) {
        var input = document.getElementById(fieldId);
        var errorEl = document.getElementById(fieldId + 'Error');
        if (message) {
          input.classList.add('is-invalid');
          errorEl.textContent = message;
          valid = false;
        } else {
          input.classList.remove('is-invalid');
          errorEl.textContent = '';
        }
      }

      var username = document.getElementById('username').value.trim();
      setError('username', username.length === 0 ? 'Username is required.' : '');

      var email = document.getElementById('email').value.trim();
      var emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      setError('email', !emailRegex.test(email) ? 'Please enter a valid email address.' : '');

      var password = document.getElementById('password').value;
      var passwordRegex = /^(?=.*[A-Za-z])(?=.*\d).{8,}$/;
      setError(
        'password',
        !passwordRegex.test(password)
          ? 'Password must be at least 8 characters and include a letter and a number.'
          : ''
      );

      var confirmPassword = document.getElementById('confirmPassword').value;
      setError('confirmPassword', password !== confirmPassword ? 'Passwords do not match.' : '');

      if (!valid) {
        event.preventDefault();
      }
    });
  </script>
</body>
</html>
