<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head-app') %>
</head>
<body>
  <%- include('../partials/navbar') %>

  <main class="auth-page">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
          <div class="auth-card text-center">
            <div class="result-icon"><i class="bi bi-check-circle"></i></div>
            <h1 class="auth-title">You're validated, <%= username %>!</h1>
            <p class="auth-subtitle"><%= email %></p>
            <p class="auth-footnote-muted">
              Real account creation with password hashing and MongoDB storage is
              implemented in Task 6.
            </p>
            <a href="/task3/login" class="btn btn-primary app-btn-cta">Continue to Log In</a>
          </div>
        </div>
      </div>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <%- include('../partials/scripts') %>
</body>
</html>
